{
  "name": "developer-secondbrain",
  "productName": "Developer SecondBrain",
  "version": "0.1.0",
  "private": true,
  "description": "Docs e boards em ficheiros Markdown, organizados em cofres.",
  "main": "dist/main/main.cjs",
  "bin": {
    "secondbrain": "bin/secondbrain.cjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win portable --x64 --publish never",
    "cli:instalar": "npm run build && npm link",
    "prepare": "npm run build"
  },
  "build": {
    "appId": "pt.developer.secondbrain",
    "productName": "Developer SecondBrain",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "secondbrain.exe"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@fontsource-variable/geist": "^5.1.0",
    "@fontsource-variable/geist-mono": "^5.1.0",
    "@lezer/highlight": "^1.2.5",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chokidar": "^6.0.0",
    "dompurify": "^3.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "minisearch": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.9"
    },
    "@electron/universal": {
      "minimatch": "^11.0.9"
    }
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0"
  }
}
